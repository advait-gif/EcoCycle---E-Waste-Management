# EcoCycle Backend — .env template
# Copy this to .env and fill in your values

# Security
SECRET_KEY=changeme-generate-a-random-64-char-secret-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=sqlite:///./ecocycle.db

# App
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=EcoCycle
API_V1_STR=/api/v1

# File uploads (local dev)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# OTP (mock in dev)
OTP_EXPIRE_MINUTES=10
