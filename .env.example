# EcoCycle Frontend Environment Variables Template
# Local dev: http://localhost:8080/api/v1 (or http://localhost:8000/api/v1)
# Production on Vercel: https://<your-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:8080/api/v1
VITE_GOOGLE_CLIENT_ID=

# Supabase Authentication & Google OAuth
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase PostgreSQL Database (Backend ORM connection)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Direct: postgresql://postgres.[project-id]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_DB_URL=
